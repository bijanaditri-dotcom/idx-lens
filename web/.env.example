# Default: a fixed, clearly labeled illustrative dataset. No API key is needed.
# Copy to .env.local for Next.js development. Never use NEXT_PUBLIC_ for tokens.

# Recommended live mode: your authorized HTTPS adapter, matching docs/PROVIDER_CONTRACT.md.
IDX_PROVIDER_URL=
IDX_PROVIDER_TOKEN=

# Optional, unofficial Yahoo daily-chart adapter for permitted personal research.
# If IDX_PROVIDER_URL is set, the licensed adapter takes precedence.
ENABLE_YAHOO_RESEARCH=false

# Optional news RSS/Atom feed that you are allowed to process. HTTPS; no redirects.
# Only exact ticker/name-relevant headlines from the last 7 days are retained.
SENTIMENT_RSS_URL=

# Explicit full-dataset demo fallback on upstream failure. Default is false.
# With false, a previously successful live snapshot is retained as stale;
# without a previous snapshot, API returns 503.
ALLOW_DEMO_FALLBACK=false

# Maximum observation ages. Tighten quote/flow values for an intraday feed.
# Four days permits daily-history research across ordinary weekends;
# it is NOT a promise of live or exchange-verified data.
QUOTE_MAX_AGE_SECONDS=345600
FLOW_MAX_AGE_SECONDS=345600
FUNDAMENTAL_MAX_AGE_SECONDS=15552000

NEXT_TELEMETRY_DISABLED=1

# Public RSS sentiment sources: Stockbit Snips + ANTARA Bursa/Finansial.
# A non-empty SENTIMENT_RSS_URL overrides this built-in source list.
ENABLE_NEWS_SENTIMENT=false

# X recent search: opt-in, official developer access, usage fees may apply.
# Configure the token as a server secret. Hosted D1 shared caching is required.
ENABLE_X_SENTIMENT=false
X_BEARER_TOKEN=

# Automatic financial statements: no manual CSV is needed.
# Unofficial Yahoo IDR financial series; corporate ratios carry reporting dates.
ENABLE_AUTO_FUNDAMENTALS=false
# Default automatic mode bypasses legacy manual snapshot overlays.
AUTOMATIC_DATA_ONLY=true
# Full registered equity catalog, durable daily batches, and open-publication archive (D1 required).
ENABLE_FULL_UNIVERSE=false
