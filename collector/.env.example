MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=stockdb
MYSQL_USER=stock_reader_writer
MYSQL_PASSWORD=replace_me

# Recent bars; daily multi-year history is a later project stage.
YAHOO_INTERVAL=1m
YAHOO_PERIOD=1d
# Leave blank to read active tickers from MySQL.
TICKERS=
YAHOO_HTTP_TIMEOUT=20
YAHOO_RETRIES=3
SYMBOL_PAUSE_SECONDS=1
LOG_LEVEL=INFO
